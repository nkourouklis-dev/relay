{
  // Relay MVP — Cloudflare Worker config
  "name": "relay",
  "main": "src/index.js",
  // Βάλε τη σημερινή ημερομηνία (YYYY-MM-DD)
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],

  // Στατικό frontend (public/) σερβίρεται από τον ίδιο Worker
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // D1 database — ΚΡΑΤΑ ΤΟ ΔΙΚΟ ΣΟΥ database_id εδώ!
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "relay-db",
      "database_id": "27c59487-655b-40a1-a779-33ffc59c9ee8"
    }
  ],

  // 🧠 Workers AI — ενεργό για έξυπνη εξαγωγή asks
  // remote: true -> στο local dev, οι κλήσεις AI πάνε στο πραγματικό Cloudflare API
  // (χωρίς αυτό, το wrangler dev μπερδεύεται και μπορεί να κάνει restart/shutdown)
  "ai": {
    "binding": "AI",
    "remote": true
  },

  // Χρονοπρογραμματισμός: κάθε μέρα 08:00 UTC για overdue checks
  "triggers": {
    "crons": ["0 8 * * *"]
  }
}

{
  "name": "relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute relay-db --file=./schema.sql --local",
    "db:remote": "wrangler d1 execute relay-db --file=./schema.sql --remote",
    "test": "node --test \"test/**/*.test.js\"",
    "build": "wrangler deploy --dry-run --outdir .wrangler/build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.1.0",
    "better-auth": "^1.7.1",
    "jose": "^6.2.12",
    "postal-mime": "^2.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260820.1": true
  }
}
